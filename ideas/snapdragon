// @title snapdragon @by lyse

setCpm(90/4)
setScale("a:minor")

kick: s("sbd!4").duck("3:4:5").duckatt(.2)

sd: s("- sd:4 - sd:4").gain(.5)

bass: n("<0 7 0 7 0 7 0 7 9 7>*16").sc().oct(-2)
  .s("supersaw")
  .unison(5)
  .acidenv(1)
  .diode(1)
  .o(3)

chords: chord("<Am F Dm Dm>").voicing().s("sawtooth")
  .rlpf(slider(0.577)).lpe(2)
  .att(.15)
  .dec(.7)
  .sus(.5)
  .dly(.7)
  .rel(.4)
  .room("1:4")
  .pg(.7)

arp: n("<0 1 2 <4 4 3>>*16").chord("<Am F Dm@2>").voicing().oct(1).s("sawtooth")
  .detune(.3).unison(1)
  .pan(rand)
  .clip(.9)
  .acidenv(slider(0.417).add(tri.div(5).slow(20)))
  .fm(slider(0.177)).fmwave("white")
  .dly(.7)
  .diode(1)

lay: n("<0 -2 -4@2>").sc().s("supersaw,wt_digital")
  .oct(-1)
  .rlpf(slider(0.806))
  .diode(1)
  .o(3)

lay_top: n("<0 -2 -4 [3@3 2 1]>").sc().s("supersaw")
  .oct(1)
  .unison(5).detune(.7)
  .rlpf(slider(0.41))
  .diode(1)
  .room("1:4")
  .pg(.6)
