// @title tec @by lyse

samples('github:kyrsive/gc-wavetables')

setCpm(140/4)
setScale("d:minor")

pluck: n(irand(7).rib(12,4)).sc().seg(16).s("wt_glitchcool:16")
  .pan(rand)
  .dly(slider(.7))
  .acidenv(slider(0.449))
  .o(3)

bass: n("<-4@2 -2@2 -1@2 0@2>".add("<0 7>*8")).oct(-1).seg(8).sc().s("supersaw")
  .diode("1:.9")
  .acidenv(slider(.5))
  .room(.3)
  .o(3)
  ._punchcard()

lead: s("tec_pad:1").note("c3").scrub(rand.seg(8).rib("<0 0 15>",1))
  .dly(slider(0.478))
  .rlpf(slider(.7))
  .flood(slider(0.802))
  .roomsize(6)
  .o(3)

pad: s("tec_pad:0").note("c2").scrub("0@3 0@5".add("<0 .2>"))
  .att(.3)
  .diode("2:.6")
  .hpf(700)
  .rlpf(slider(0.38))
  .room(1)
  .o(3)

kick: s("sbd").beat("0,4,8,11,14",16)
  .duck("3:4:5").duckdepth(.7)

top: s("hat_loops:2").ifit(2).diode("1:.3").rlpf(.8).pg(.8)
